# PostgreSQL（不可用时服务端自动降级为本地 JSON 文件存储）
DATABASE_URL=postgres://blockeditor:blockeditor@localhost:5432/blockeditor
# Redis（不可用时降级为进程内内存缓存）
REDIS_URL=redis://localhost:6379
# 开发态演示 JWT 签名密钥
JWT_SECRET=dev-secret-change-me
HTTP_PORT=3000
CORS_ORIGIN=http://localhost:5173
# 对象存储（迭代 2 图片块，S3 兼容）
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=blockeditor
